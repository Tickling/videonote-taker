# Домен сервера. Нет своего домена — подойдёт бесплатный вида 1-2-3-4.sslip.io
# (замените 1-2-3-4 на IP вашего сервера через дефисы). install.sh подставит его сам.
DOMAIN=

# Какие сайты обрабатывает сервер (YouTube расширение обрабатывает само, в браузере)
ALLOWED_PLATFORMS=rutube,vk_video

# Защита от злоупотреблений: запросов в минуту и задач в час с одного IP
RATE_LIMIT_PER_MINUTE=120
JOBS_PER_HOUR_PER_IP=30
MAX_CONCURRENT_JOBS=2

LOG_LEVEL=info
CORS_ORIGINS=chrome-extension://*
