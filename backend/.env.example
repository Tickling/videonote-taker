# ==== Сервер VideoNote Taker ====
# Менять ничего не обязательно — всё работает по умолчанию.

PORT=3000
# 127.0.0.1 — сервер доступен только с этого компьютера (безопасно)
HOST=127.0.0.1
LOG_LEVEL=info

# Кто может обращаться к серверу (расширения Chrome)
CORS_ORIGINS=chrome-extension://*

# Где хранить историю задач и временные файлы
DATABASE_PATH=./data/videonote.sqlite
TMP_DIR=./tmp

# Программы (если они не в PATH — укажите полный путь)
YTDLP_PATH=yt-dlp

# Прокси для скачивания с YouTube (если YouTube у вас работает только через VPN).
# Адрес смотрите в настройках VPN-клиента («локальный прокси», «SOCKS5», «HTTP»), например:
# YTDLP_PROXY=socks5://127.0.0.1:10808
# YTDLP_PROXY=http://127.0.0.1:2080
FFMPEG_PATH=ffmpeg

# ---- Локальный Whisper (необязательно, см. local-whisper-guide.pdf) ----
# WHISPER_CPP_PATH=/путь/к/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/путь/к/whisper.cpp/models/ggml-medium.bin

# ---- Ключ Groq для всех пользователей сервера (необязательно) ----
# Ключи пользователей хранятся в браузере и приходят в заголовках запроса.
# GROQ_API_KEY=gsk_...

MAX_CONCURRENT_JOBS=2
